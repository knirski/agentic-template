{
  "permissions": {
    "deny": [
      "Bash(git commit --no-verify)",
      "Bash(git push --no-verify)",
      "Bash(git push --force)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/secret_scan.py"
          }
        ]
      }
    ]
  }
}
